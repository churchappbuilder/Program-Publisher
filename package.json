{
  "name": "program-publisher",
  "productName": "Program Publisher",
  "version": "0.3.0",
  "description": "Free, offline tool for designing and printing programs and bulletins for churches, schools and events.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "icons": "electron build/make-icons.js",
    "dist": "electron-builder --win --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/churchappbuilder/Program-Publisher.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "churchappbuilder",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "build": {
    "appId": "org.churchappbuilder.programpublisher",
    "productName": "Program Publisher",
    "copyright": "Copyright © churchappbuilder. Licensed under GPL-3.0-or-later.",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json", "LICENSE"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Program Publisher",
      "license": "LICENSE"
    }
  }
}
